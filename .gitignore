# -----------------------------
# Data & artifacts
# -----------------------------
# Ignore typical data files by default. Whitelist the ones you want to commit.
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
*.h5
*.hdf5
*.jsonl
*.json
*.pickle
*.pkl
*.sav
*.dta
*.sqlite
*.db
*.zip
*.gz
*.bz2
*.7z
*.tar

# If you need to track a specific dataset, unignore it below, e.g.:
# !laptop_price.csv
# Or keep tracked data under a dedicated small-data folder:
# data/
# !data/README.md
# !data/samples/**

# Logs
*.log
logs/

# Outputs & reports
outputs/
reports/
artifacts/

# -----------------------------
# IDE / Editor
# -----------------------------
# PyCharm / IntelliJ
.idea/
# VS Code (if used)
.vscode/

# JetBrains caches
.jb/

# -----------------------------
# Misc
# -----------------------------
*.swp
*.swo
*.orig
*.bak
*.tmp

# Local environment config
.env
.env.*
*.env

# IPyKernel connection files (transient)
kernel-*.json

# Plotly/Matplotlib cache (optional)
.matplotlib/

# Jupyter lab/stage (if present)
.jupyter